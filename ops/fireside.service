[Unit]
Description=Fireside Topic Platform
Documentation=https://github.com/ShijunDeng/fireside
Requires=fireside.socket fireside-release-recover.service fireside-runtime-gate.service
After=network.target fireside.socket fireside-release-recover.service fireside-runtime-gate.service
RequiresMountsFor=/opt/fireside /var/lib/fireside /var/lib/fireside-release

[Service]
Type=exec
User=fireside
Group=fireside
WorkingDirectory=-/run/fireside-runtime/current
Environment=NODE_ENV=production
Environment=DATABASE_PATH=/var/lib/fireside/fireside.db
EnvironmentFile=/etc/fireside.env
ExecStart=/usr/bin/node /run/fireside-runtime/current/server-build/server/index.js
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077

StateDirectory=fireside
StateDirectoryMode=0700
ReadWritePaths=/var/lib/fireside
ReadOnlyPaths=/run/fireside-runtime
InaccessiblePaths=/etc/fireside.env

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RemoveIPC=true
KeyringMode=private

[Install]
WantedBy=multi-user.target
